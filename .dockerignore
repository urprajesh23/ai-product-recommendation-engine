# .dockerignore
# Files and directories to exclude from Docker build context

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/

# Virtual environments
venv/
env/
ENV/
.venv

# IDEs
.vscode/
.idea/
*.swp
*.swo

# Git
.git/
.gitignore
.gitattributes

# Data
data/raw/*.json
data/raw/*.json.gz
data/raw/*.csv
data/processed/*.csv
data/processed/*.pkl

# Models (will be mounted as volume)
models/*.pkl
models/*.h5
models/*.pt

# MLflow
mlruns/
mlartifacts/

# Logs
logs/
*.log

# Tests
tests/
.pytest_cache/
.coverage
htmlcov/

# Notebooks
notebooks/
.ipynb_checkpoints/

# Docker
Dockerfile
docker-compose.yml
.dockerignore

# Documentation
# *.md
docs/

# OS
.DS_Store
Thumbs.db

# Temporary files
tmp/
temp/
*.tmp

# Environment files
.env
.env.*