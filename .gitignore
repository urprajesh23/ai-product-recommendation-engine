data/raw/*.json.gz
data/raw/*.csv
data/raw/*.tsv
data/raw/*.parquet
data/raw/*.feather

# Processed data files
data/processed/*.csv
data/processed/*.pkl
data/processed/*.npz
data/processed/*.h5
data/processed/*.parquet

# Exclude sample data (keep for examples)
!data/raw/sample_*.csv
!data/processed/sample_*.pkl

